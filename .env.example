# Copy this file to .env and adjust as needed. The app runs fine with
# nothing set at all.

# Optional. If omitted, the app uses a local SQLite file (precursor.db)
# automatically - no database server required.
# Example for Postgres: postgresql://user:password@localhost:5432/precursor
# (also `pip install psycopg2-binary` if you switch to Postgres)
# DATABASE_URL=

# Optional. If omitted, AI tagging/severity falls back to a simple offline
# keyword-based analyzer, so the app is fully usable with no API key.
# Get a free key at https://aistudio.google.com/app/apikey to enable real
# Gemini-based analysis instead.
# GEMINI_API_KEY=
